### Python Program

```python
def transform(grid):
    # Determine the two non-zero colors that appear most frequently.
    from collections import defaultdict
    freq = defaultdict(int)
    h = len(grid)
    w = len(grid[0])
    for i in range(h):
        for j in range(w):
            c = grid[i][j]
            if c != 0:
                freq[c] += 1
    # If less than two colors, return grid unchanged.
    if len(freq) < 2:
        return grid
    # Get the two most frequent colors.
    colors = sorted(freq.keys(), key=lambda c: -freq[c])
    colA, colB = colors[0], colors[1]
    
    # Create output grid as a copy.
    out = [row[:] for row in grid]
    
    # First pass: identify cells that will become 8.
    for i in range(h):
        for j in range(w):
            if grid[i][j] == 0:
                # Check 8-neighborhood for both colors.
                hasA = False
                hasB = False
                for di in [-1,0,1]:
                    for dj in [-1,0,1]:
                        if di == 0 and dj == 0:
                            continue
                        ni, nj = i+di, j+dj
                        if 0 <= ni < h and 0 <= nj < w:
                            val = grid[ni][nj]
                            if val == colA:
                                hasA = True
                            elif val == colB:
                                hasB = True
                if hasA and hasB:
                    out[i][j] = 8
                    # Swap colors in the 8-neighborhood.
                    for di in [-1,0,1]:
                        for dj in [-1,0,1]:
                            if di == 0 and dj == 0:
                                continue
                            ni, nj = i+di, j+dj
                            if 0 <= ni < h and 0 <= nj < w:
                                if out[ni][nj] == colA:
                                    out[ni][nj] = colB
                                elif out[ni][nj] == colB:
                                    out[ni][nj] = colA
    return out
```

