                    output[cr][try_c + (cc - min_c)] = color
                placed.append((cells, try_c, try_c + width - 1, min_r, max_r))
                found = True
                break
        if not found:
            # If cannot place without overlap, place at original position
            for cr, cc, color in cells:
                output[cr][cc] = color
            placed.append((cells, min_c, max_c, min_r, max_r))
    
    return output
```

