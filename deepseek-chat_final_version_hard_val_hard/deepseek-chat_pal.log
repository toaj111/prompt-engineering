### Python Program

```python
def transform(grid):
    # grid is list of lists of ints
    n_rows = len(grid)
    n_cols = len(grid[0])
    
    # find vertical line column: column where all rows have the same value > 0
    vcol = None
    for col in range(n_cols):
        val = grid[0][col]
        if val == 0:
            continue
        all_same = True
        for row in range(1, n_rows):
            if grid[row][col] != val:
                all_same = False
                break
        if all_same:
            vcol = col
            break
    # if not found, return original (should not happen)
    if vcol is None:
        return grid
    
    # create output grid as copy of input
    output = [row[:] for row in grid]
    
    # process each row
    for r in range(n_rows):
        # find contiguous blocks left of vcol
        blocks = []
        c = 0
        while c < vcol:
            if grid[r][c] != 0:
                color = grid[r][c]
                start = c
                while c < vcol and grid[r][c] == color:
                    c += 1
                width = c - start
                blocks.append((color, width))
            else:
                c += 1
        
        # apply each block
        for color, width in blocks:
            k = 0
            col_idx = vcol + 1 + k * width
            while col_idx < n_cols:
                output[r][col_idx] = color
                k += 1
                col_idx = vcol + 1 + k * width
    
    return output
```

