### Python Program

```python
def transform(grid):
    h = len(grid)
    w = len(grid[0])
    # create output copy
    out = [row[:] for row in grid]
    
    # helper to check if cell (r,c) is within grid
    def inside(r,c):
        return 0 <= r < h and 0 <= c < w
    
    # mark vertical strips: columns that have at least one vertical run of length >=2 of same non-8 color
    vertical_strip_cols = set()
    for c in range(w):
        r = 0
        while r < h:
            color = grid[r][c]
            if color != 8:
                run_len = 1
                while r+run_len < h and grid[r+run_len][c] == color:
                    run_len += 1
                if run_len >= 2:
                    for dr in range(run_len):
                        vertical_strip_cols.add(c)
                r += run_len
            else:
                r += 1
    
    # mark horizontal strips: rows that have at least one horizontal run of length >=2 of same non-8 color
    horizontal_strip_rows = set()
    for r in range(h):
        c = 0
        while c < w:
            color = grid[r][c]
            if color != 8:
                run_len = 1
                while c+run_len < w and grid[r][c+run_len] == color:
                    run_len += 1
                if run_len >= 2:
                    for dc in range(run_len):
                        horizontal_strip_rows.add(r)
                c += run_len
            else:
                c += 1
    
    # find lonely cells: color !=8 and not part of any run of length >=2 in either direction
    lonely = []
    for r in range(h):
        for c in range(w):
            col = grid[r][c]
            if col == 8:
                continue
            # check horizontal run length
            h_run = 1
            # left
            cc = c-1
            while cc >=0 and grid[r][cc] == col:
                h_run += 1
                cc -= 1
            # right
            cc = c+1
            while cc < w and grid[r][cc] == col:
                h_run += 1
                cc += 1
            # vertical run length
            v_run = 1
            rr = r-1
            while rr >=0 and grid[rr][c] == col:
                v_run += 1
                rr -= 1
            rr = r+1
            while rr < h and grid[rr][c] == col:
                v_run += 1
                rr += 1
            if h_run == 1 and v_run == 1:
                lonely.append((r,c,col))
    
    # for each lonely cell
    for r,c,col in lonely:
        # row fill: find nearest vertical strip left and right
        left_col = -1
        for cc in range(c-1, -1, -1):
            if cc in vertical_strip_cols:
                left_col = cc
                break
        right_col = w
        for cc in range(c+1, w):
            if cc in vertical_strip_cols:
                right_col = cc
                break
        if left_col != -1 and right_col != w:
            for cc in range(left_col+1, right_col):
                out[r][cc] = col
        
        # column fill: find nearest horizontal strip above and below
        above_row = -1
        for rr in range(r-1, -1, -1):
            if rr in horizontal_strip_rows:
                above_row = rr
                break
        below_row = h
        for rr in range(r+1, h):
            if rr in horizontal_strip_rows:
                below_row = rr
                break
        if above_row != -1 and below_row != h:
            for rr in range(above_row+1, below_row):
                out[rr][c] = col
    
    return out
```

