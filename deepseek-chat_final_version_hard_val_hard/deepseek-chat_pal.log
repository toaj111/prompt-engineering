def transform(grid):
    H = len(grid)
    W = len(grid[0])
    # directions
    dirs = [(-1,0),(1,0),(0,-1),(0,1)]
    
    # helper: bfs for components of a specific color
    def components_of_color(color):
        visited = [[False]*W for _ in range(H)]
        comps = []
        for r in range(H):
            for c in range(W):
                if grid[r][c]==color and not visited[r][c]:
                    # bfs
                    cells = []
                    queue = [(r,c)]
                    visited[r][c]=True
                    while queue:
                        cr,cc = queue.pop(0)
                        cells.append((cr,cc))
                        for dr,dc in dirs:
                            nr,nc = cr+dr, cc+dc
                            if 0<=nr<H and 0<=nc<W and grid[nr][nc]==color and not visited[nr][nc]:
                                visited[nr][nc]=True
                                queue.append((nr,nc))
                    comps.append(cells)
        return comps
    
