### Python Program

```python
def transform(grid):
    # Collect all non-zero cells in row-major order
    nonzeros = []
    for r in range(len(grid)):
        for c in range(len(grid[0])):
            if grid[r][c] != 0:
                nonzeros.append(grid[r][c])
    if not nonzeros:
        return []
    # Determine output rows: try 8, if not enough cells, use 7, else use sqrt
    rows = 8
    if len(nonzeros) % rows != 0:
        # try 7
        if len(nonzeros) % 7 == 0:
            rows = 7
        else:
            # find divisor close to sqrt
            rows = int(len(nonzeros) ** 0.5)
            while len(nonzeros) % rows != 0 and rows > 1:
                rows -= 1
    cols = len(nonzeros) // rows
    # Reshape
    output = []
    for i in range(rows):
        output.append(nonzeros[i*cols:(i+1)*cols])
    return output
```

