def transform(grid):
    # Determine background color as the most frequent color
    from collections import defaultdict
    freq = defaultdict(int)
    for row in grid:
        for val in row:
            freq[val] += 1
    background = max(freq.items(), key=lambda x: x[1])[0]
    
    h = len(grid)
    w = len(grid[0])
    # Create output grid filled with background
