def transform(grid):
    # Determine canvas color: most frequent non-zero color
    from collections import defaultdict
    freq = defaultdict(int)
    for row in grid:
        for v in row:
            if v != 0:
                freq[v] += 1
    if not freq:
        return grid
    canvas_color = max(freq.items(), key=lambda x: x[1])[0]
    
    # Create output grid initially all zeros
    h = len(grid)
    w = len(grid[0])
    out = [[0]*w for _ in range(h)]
    
    # Copy canvas cells
    for r in range(h):
        for c in range(w):
            if grid[r][c] == canvas_color:
                out[r][c] = canvas_color
    
    # Collect other colors and their positions
    other = []
    for r in range(h):
        for c in range(w):
            v = grid[r][c]
            if v != 0 and v != canvas_color:
                other.append((r, c, v))
    
