                            nr, nc = r+dr, c+dc
                            if in_grid(nr, nc) and not local_visited[nr][nc]:
                                local_visited[nr][nc] = True
                                col = grid[nr][nc]
                                if col != 2 and col != background:
                                    cells.append((nr, nc, col))
                                    stack.append((nr, nc))
                # rotate each cell 180 degrees around (r0,c0)
                for r, c, col in cells:
                    nr = 2*r0 - r
                    nc = 2*c0 - c
                    if in_grid(nr, nc):
                        output[nr][nc] = col
    
    return output
