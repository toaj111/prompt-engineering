### Python Program

```python
def transform(grid):
    H = len(grid)
    W = len(grid[0])
    border_color = grid[0][0]
    # find border columns (full column of border_color)
    border_cols = []
    for j in range(W):
        is_border = True
        for i in range(H):
            if grid[i][j] != border_color:
                is_border = False
                break
        if is_border:
            border_cols.append(j)
    # interior width (number of columns between two consecutive border columns, excluding borders)
    interior_width = border_cols[1] - border_cols[0] - 1
    num_blocks = len(border_cols) - 1
    # output width = interior_width + 2
    out_W = interior_width + 2
    # prepare output grid
    output = []
    for r in range(H):
        out_row = [0] * out_W
        out_row[0] = border_color
        out_row[out_W-1] = border_color
        for k in range(interior_width):
            colors = []
            for b in range(num_blocks):
                col = border_cols[b] + 1 + k
                colors.append(grid[r][col])
            # compute frequencies
            freq = {}
            for c in colors:
                freq[c] = freq.get(c, 0) + 1
            min_freq = min(freq.values())
            candidates = [c for c in freq if freq[c] == min_freq]
            chosen = min(candidates)  # tie-break by smallest color
            out_row[k+1] = chosen
        output.append(out_row)
    return output
```

