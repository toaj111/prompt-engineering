### Python Program

```python
def transform(grid):
    if not grid or not grid[0]:
        return []
    h = len(grid)
    w = len(grid[0])
    bg = grid[0][0]  # background color
    # dict: color -> [first_row, first_col, count]
    info = {}
    for i in range(h):
        for j in range(w):
            c = grid[i][j]
            if c != bg:
                if c not in info:
                    info[c] = [i, j, 0]
                info[c][2] += 1
    # convert to list of (color, first_row, first_col, count)
    items = [(color, info[color][0], info[color][1], info[color][2]) for color in info]
    # sort by first_row then first_col
    items.sort(key=lambda x: (x[1], x[2]))
    # build column
    column = []
    for color, _, _, count in items:
        column.extend([color] * count)
    # convert to list of single-element lists
    result = [[val] for val in column]
    return result
```

