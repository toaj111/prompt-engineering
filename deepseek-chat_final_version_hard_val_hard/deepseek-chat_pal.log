### Python Program

```python
def transform(grid):
    rows = len(grid)
    cols = len(grid[0]) if rows > 0 else 0
    
    def get_block(r, c):
        # return 4x4 block as list of lists
        block = []
        for i in range(4):
            row = []
            for j in range(4):
                row.append(grid[r + i][c + j])
            block.append(row)
        return block
    
    def is_solid(block):
        color = block[0][0]
        if color == 0:
            return False, None
        for i in range(4):
            for j in range(4):
                if block[i][j] != color:
                    return False, None
        return True, color
    
    def is_hollow(block):
        # check outer border all same non-zero color, inner 2x2 all zeros
        color = block[0][0]
        if color == 0:
            return False, None
        # check border
        for i in range(4):
            if block[i][0] != color or block[i][3] != color:
                return False, None
        for j in range(4):
            if block[0][j] != color or block[3][j] != color:
                return False, None
        # check inner 2x2 zeros
        for i in range(1, 3):
            for j in range(1, 3):
                if block[i][j] != 0:
                    return False, None
        return True, color
    
    hollows = []  # list of (color, r, c)
    solids = []
    
    for r in range(rows - 3):
        for c in range(cols - 3):
            block = get_block(r, c)
            solid, col_s = is_solid(block)
            hollow, col_h = is_hollow(block)
            if solid:
                solids.append((col_s, r, c))
            elif hollow:
                hollows.append((col_h, r, c))
            # note: a block cannot be both solid and hollow
    
    # sort by reading order (row then column)
    hollows.sort(key=lambda x: (x[1], x[2]))
    solids.sort(key=lambda x: (x[1], x[2]))
    
    hollow_colors = [h[0] for h in hollows]
    solid_colors = [s[0] for s in solids]
    
    num_rows = max(len(hollow_colors), len(solid_colors))
    out_height = num_rows * 4
    out_width = 8
    output = [[0 for _ in range(out_width)] for _ in range(out_height)]
    
    for i in range(num_rows):
        base_row = i * 4
        # left block (hollow or zeros)
        left_color = hollow_colors[i] if i < len(hollow_colors) else 0
        # right block (solid or zeros)
        right_color = solid_colors[i] if i < len(solid_colors) else 0
        
        # fill left block (4x4)
        for dr in range(4):
            for dc in range(4):
                val = 0
                if left_color != 0:
                    # hollow pattern
                    if dr == 0 or dr == 3 or dc == 0 or dc == 3:
                        val = left_color
                    else:
                        val = 0
                else:
                    val = 0
                output[base_row + dr][dc] = val
        
        # fill right block (4x4)
        for dr in range(4):
            for dc in range(4):
                val = 0
                if right_color != 0:
                    # solid pattern
                    val = right_color
                else:
                    val = 0
                output[base_row + dr][4 + dc] = val
    
    return output
```

