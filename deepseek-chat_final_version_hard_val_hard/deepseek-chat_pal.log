### Python Program

```python
def transform(grid):
    rows = len(grid)
    cols = len(grid[0])
    # threshold for a column to be considered part of a block
    threshold = 5
    # compute column activity
    col_active = [False] * cols
    for c in range(cols):
        cnt = 0
        for r in range(rows):
            if grid[r][c] != 0:
                cnt += 1
        if cnt >= threshold:
            col_active[c] = True
    # find first block start and width
    first_start = -1
    first_end = -1
    for c in range(cols):
        if col_active[c]:
            first_start = c
            break
    if first_start == -1:
        # no active columns, return all zeros
        return [[0]*cols for _ in range(rows)]
    # find width of first block
    w = 0
    while first_start + w < cols and col_active[first_start + w]:
        w += 1
    # extract template block
    template = [[0]*w for _ in range(rows)]
    for r in range(rows):
        for c in range(w):
            template[r][c] = grid[r][first_start + c]
    # prepare output grid initially all zeros
    output = [[0]*cols for _ in range(rows)]
    # replicate template to every block of width w
    c = 0
    while c < cols:
        if col_active[c]:
            # check if there is a contiguous block of active columns of width w
            ok = True
            for k in range(w):
                if c + k >= cols or not col_active[c + k]:
                    ok = False
                    break
            if ok:
                # copy template
                for r in range(rows):
                    for k in range(w):
                        output[r][c + k] = template[r][k]
                c += w
                continue
        c += 1
    return output
```

