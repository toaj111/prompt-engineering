Implementation details:
1. Shift left: For each row, collect non‑bg cells, then create new row: those cells followed by bg to fill width.
2. Shift up: Transpose, do same as shift left (which becomes shift up), transpose back.
3. Crop: Find min/max row/col with non‑bg, slice.

Let's code.

### Python Program

```python
def transform(grid):
    if not grid:
        return []
    H = len(grid)
    W = len(grid[0])
    bg = grid[0][0]
    
    # helper to shift non-bg cells left in each row
    def shift_left(g):
        new_g = []
        for r in range(H):
            row = g[r]
            new_row = [c for c in row if c != bg]
            new_row += [bg] * (W - len(new_row))
            new_g.append(new_row)
        return new_g
    
    # helper to shift non-bg cells up (by transposing, shifting left, transposing back)
    def shift_up(g):
        # transpose
        trans = [[g[r][c] for r in range(H)] for c in range(W)]
        # shift left (which is shift up in original)
        shifted_trans = shift_left(trans)
        # transpose back
        new_g = [[shifted_trans[c][r] for c in range(W)] for r in range(H)]
        return new_g
    
    # apply shift left then shift up
    temp = shift_left(grid)
    temp = shift_up(temp)
    
    # crop to remove surrounding bg rows and columns
    # find min/max row with non-bg
    min_r = H
    max_r = -1
    min_c = W
    max_c = -1
    for r in range(H):
        for c in range(W):
            if temp[r][c] != bg:
                if r < min_r:
                    min_r = r
                if r > max_r:
                    max_r = r
                if c < min_c:
                    min_c = c
                if c > max_c:
                    max_c = c
    # if no non-bg cells, return empty grid
    if min_r > max_r or min_c > max_c:
        return [[]]
    # slice
    result = []
    for r in range(min_r, max_r + 1):
        result.append(temp[r][min_c:max_c + 1])
    return result
```

