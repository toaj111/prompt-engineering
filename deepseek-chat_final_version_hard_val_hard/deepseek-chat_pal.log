### Python Program

```python
def transform(grid):
    h = len(grid)
    w = len(grid[0])
    # copy grid to output
    output = [row[:] for row in grid]
    
    # find background color (most frequent)
    freq = {}
    for r in range(h):
        for c in range(w):
            col = grid[r][c]
            freq[col] = freq.get(col, 0) + 1
    background = max(freq.items(), key=lambda x: x[1])[0]
    
    # helper: check if a cell is within grid
    def in_grid(r, c):
        return 0 <= r < h and 0 <= c < w
    
    # mark cells that are part of horizontal lines length >=2
    hor_line = [[False]*w for _ in range(h)]
    for r in range(h):
        c = 0
        while c < w:
            if grid[r][c] == 2:
                start = c
                while c < w and grid[r][c] == 2:
                    c += 1
                end = c - 1
                length = end - start + 1
                if length >= 2:
                    for cc in range(start, end+1):
                        hor_line[r][cc] = True
            else:
                c += 1
    
    # mark cells that are part of vertical lines length >=2
    ver_line = [[False]*w for _ in range(h)]
    for c in range(w):
        r = 0
        while r < h:
            if grid[r][c] == 2:
                start = r
                while r < h and grid[r][c] == 2:
                    r += 1
                end = r - 1
                length = end - start + 1
                if length >= 2:
                    for rr in range(start, end+1):
                        ver_line[rr][c] = True
            else:
                r += 1
    
    # process horizontal lines
    for r in range(h):
        c = 0
        while c < w:
            if hor_line[r][c]:
                start = c
                while c < w and hor_line[r][c]:
                    c += 1
                end = c - 1
                # horizontal line from (r,start) to (r,end)
                for cc in range(start, end+1):
                    # copy above to below and below to above
                    d = 1
                    while True:
                        above_r = r - d
                        below_r = r + d
                        above_ok = in_grid(above_r, cc)
                        below_ok = in_grid(below_r, cc)
                        if not above_ok and not below_ok:
                            break
                        if above_ok:
                            col_above = grid[above_r][cc]
                            if col_above != 2 and col_above != background:
                                # copy to below symmetric position
                                target_r = r + d
                                if in_grid(target_r, cc):
                                    output[target_r][cc] = col_above
                        if below_ok:
                            col_below = grid[below_r][cc]
                            if col_below != 2 and col_below != background:
                                target_r = r - d
                                if in_grid(target_r, cc):
                                    output[target_r][cc] = col_below
                        d += 1
            else:
                c += 1
    
    # process vertical lines
    for c in range(w):
        r = 0
        while r < h:
            if ver_line[r][c]:
                start = r
                while r < h and ver_line[r][c]:
                    r += 1
                end = r - 1
                # vertical line from (start,c) to (end,c)
                for rr in range(start, end+1):
                    d = 1
                    while True:
                        left_c = c - d
                        right_c = c + d
                        left_ok = in_grid(rr, left_c)
                        right_ok = in_grid(rr, right_c)
                        if not left_ok and not right_ok:
                            break
                        if left_ok:
                            col_left = grid[rr][left_c]
                            if col_left != 2 and col_left != background:
                                target_c = c + d
                                if in_grid(rr, target_c):
                                    output[rr][target_c] = col_left
                        if right_ok:
                            col_right = grid[rr][right_c]
                            if col_right != 2 and col_right != background:
                                target_c = c - d
                                if in_grid(rr, target_c):
                                    output[rr][target_c] = col_right
                        d += 1
            else:
                r += 1
    
    # process isolated 2's (not part of any horizontal or vertical line >=2)
    visited = [[False]*w for _ in range(h)]
    for r0 in range(h):
        for c0 in range(w):
            if grid[r0][c0] == 2 and not hor_line[r0][c0] and not ver_line[r0][c0]:
                # collect connected non-background, non-2 cells using 8-direction
                stack = [(r0, c0)]
                cells = []
                local_visited = [[False]*w for _ in range(h)]
                local_visited[r0][c0] = True
                while stack:
                    r, c = stack.pop()
                    for dr in [-1,0,1]:
                        for dc in [-1,0,1]:
                            if dr == 0 and dc == 0:
