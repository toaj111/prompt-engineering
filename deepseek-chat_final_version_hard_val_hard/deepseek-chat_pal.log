### Python Program

```python
def transform(grid):
    H = len(grid)
    W = len(grid[0])
    
    # Find background color (most frequent)
    freq = {}
    for r in range(H):
        for c in range(W):
            col = grid[r][c]
            freq[col] = freq.get(col, 0) + 1
    background = max(freq, key=freq.get)
    
    # Helper: BFS to get connected component
    visited = [[False]*W for _ in range(H)]
    components = []
    
    for r in range(H):
        for c in range(W):
            if not visited[r][c] and grid[r][c] != background:
                color = grid[r][c]
                queue = [(r,c)]
                visited[r][c] = True
                cells = []
                min_r, max_r = r, r
                min_c, max_c = c, c
                while queue:
                    cr, cc = queue.pop(0)
                    cells.append((cr,cc))
                    min_r = min(min_r, cr)
                    max_r = max(max_r, cr)
                    min_c = min(min_c, cc)
                    max_c = max(max_c, cc)
                    for dr, dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                        nr, nc = cr+dr, cc+dc
                        if 0 <= nr < H and 0 <= nc < W and not visited[nr][nc] and grid[nr][nc] == color:
                            visited[nr][nc] = True
                            queue.append((nr,nc))
                # Check if component fills its bounding box uniformly
                is_rect = True
                for rr in range(min_r, max_r+1):
                    for cc in range(min_c, max_c+1):
                        if grid[rr][cc] != color:
                            is_rect = False
                            break
                    if not is_rect:
                        break
                if is_rect:
                    area = (max_r-min_r+1)*(max_c-min_c+1)
                    components.append({
                        'color': color,
                        'min_r': min_r,
                        'max_r': max_r,
                        'min_c': min_c,
                        'max_c': max_c,
                        'area': area,
                        'cells': cells
                    })
    
    # Sort components by area descending
    components.sort(key=lambda comp: comp['area'], reverse=True)
    
    # Find the two largest components with different colors and color != 1
    candidates = []
    for comp in components:
        if comp['color'] != 1:
            candidates.append(comp)
    if len(candidates) >= 2:
        # Swap colors of the two largest
        col1 = candidates[0]['color']
        col2 = candidates[1]['color']
        for comp in components:
            if comp['color'] == col1:
                comp['new_color'] = col2
            elif comp['color'] == col2:
                comp['new_color'] = col1
            else:
                comp['new_color'] = comp['color']
    else:
        for comp in components:
            comp['new_color'] = comp['color']
    
    # Create output grid
    out = [row[:] for row in grid]
    for comp in components:
        new_color = comp['new_color']
        for (r,c) in comp['cells']:
            out[r][c] = new_color
    
    return out
```

