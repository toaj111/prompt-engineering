### Python Program

```python
def transform(grid):
    H = len(grid)
    W = len(grid[0])
    # make a deep copy to modify
    new_grid = [row[:] for row in grid]
    
    # Helper to check if a cell is background (0) or not. In these examples background is 8? Actually background is 8, but rule might be any non-zero? Usually 0 is background, but here 8 is background. We'll treat any color that appears as background? Safer: treat cells with color same as the majority? Not reliable.
    # Instead, we consider a cell as foreground if its color != 8? But what if other colors are used as background? In ARC, 0 is usually background, but here 0 not present. The background is consistently 8 in both examples. So we assume background color is 8.
    bg = 8
    
    # Find vertical seed
    vertical_found = False
    seed_col = -1
    seed_start = -1
    colorA = -1
    colorB = -1
    for c in range(W):
        r = 0
        while r < H:
            # skip background
            if new_grid[r][c] == bg:
                r += 1
                continue
            # start of segment
            start = r
            seg_colors = []
            while r < H and new_grid[r][c] != bg:
                seg_colors.append(new_grid[r][c])
                r += 1
            # check segment length >=2 and all colors distinct
            if len(seg_colors) >= 2:
                # check all distinct
                distinct = True
                for i in range(len(seg_colors)-1):
                    if seg_colors[i] == seg_colors[i+1]:
                        distinct = False
                        break
                if distinct:
                    vertical_found = True
                    seed_col = c
                    seed_start = start
                    colorA = seg_colors[0]
                    colorB = seg_colors[1]
                    break
            # else continue scanning
        if vertical_found:
            break
    
    if vertical_found:
        # propagate upward alternating
        for row in range(seed_start):
            if row % 2 == 0:
                new_grid[row][seed_col] = colorB
            else:
                new_grid[row][seed_col] = colorA
        return new_grid
    
    # Find horizontal seed
    horizontal_found = False
    seed_row = -1
    seed_col_start = -1
    seed_colors = []
    for r in range(H):
        c = 0
        while c < W:
            if new_grid[r][c] == bg:
                c += 1
                continue
            start = c
            seg_colors = []
            while c < W and new_grid[r][c] != bg:
                seg_colors.append(new_grid[r][c])
                c += 1
            if len(seg_colors) >= 2:
                distinct = True
                for i in range(len(seg_colors)-1):
                    if seg_colors[i] == seg_colors[i+1]:
                        distinct = False
                        break
                if distinct:
                    horizontal_found = True
                    seed_row = r
                    seed_col_start = start
                    seed_colors = seg_colors
                    break
        if horizontal_found:
            break
    
    if horizontal_found:
        # propagate each column upward
        for idx, col in enumerate(range(seed_col_start, seed_col_start + len(seed_colors))):
            color = seed_colors[idx]
            for row in range(seed_row):
                new_grid[row][col] = color
        return new_grid
    
    # If no seed found, return original
    return new_grid
```

