### Python Program

```python
def transform(grid):
    h = len(grid)
    w = len(grid[0])
    target_color = grid[0][0]
    
    # visited matrix
    visited = [[False]*w for _ in range(h)]
    # directions
    dirs = [(1,0),(-1,0),(0,1),(0,-1)]
    
    components = []  # each component: (color, list of (r,c))
    
    for r in range(h):
        for c in range(w):
            if grid[r][c] != 0 and not visited[r][c]:
                color = grid[r][c]
                stack = [(r,c)]
                visited[r][c] = True
                cells = []
                while stack:
                    cr, cc = stack.pop()
                    cells.append((cr, cc))
                    for dr, dc in dirs:
                        nr, nc = cr+dr, cc+dc
                        if 0 <= nr < h and 0 <= nc < w and not visited[nr][nc] and grid[nr][nc] == color:
                            visited[nr][nc] = True
                            stack.append((nr, nc))
                components.append((color, cells))
    
    # Process components: handle target color
    new_components = []
    for color, cells in components:
        if color == target_color:
            # check if contains (0,0)
            if (0,0) in cells:
                # keep only (0,0)
                new_components.append((color, [(0,0)]))
            # else discard entirely
        else:
            new_components.append((color, cells))
    
    # Sort components by max row descending (lowest bottom first)
    new_components.sort(key=lambda x: max(r for r,_ in x[1]), reverse=True)
    
    # Occupancy grid
    occupied = [[False]*w for _ in range(h)]
    # Place top-left cell if present (should be)
    # Actually it's already in new_components as a single cell component.
    # We'll place components one by one.
    final_places = []  # (color, list of final (r,c))
    
    for color, cells in new_components:
        # compute min row, max row, min col, max col
        rows = [r for r,_ in cells]
        cols = [c for _,c in cells]
        min_r, max_r = min(rows), max(rows)
        # find maximum shift d
        max_d = h - 1 - max_r  # theoretical max shift without going out
        # but need to check collision with occupied cells
        best_d = 0
        for d in range(0, max_d+1):
            ok = True
            for r, c in cells:
                nr = r + d
                if nr >= h or occupied[nr][c]:
                    ok = False
                    break
            if ok:
                best_d = d
            else:
                break
        # shift by best_d
        new_cells = [(r+best_d, c) for r,c in cells]
        # mark occupied
        for nr, nc in new_cells:
            occupied[nr][nc] = True
        final_places.append((color, new_cells))
    
    # Build output grid
    out = [[0]*w for _ in range(h)]
    for color, cells in final_places:
        for r, c in cells:
            out[r][c] = color
    
    return out
```

