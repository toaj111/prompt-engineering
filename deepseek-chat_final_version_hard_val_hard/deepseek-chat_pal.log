### Python Program

```python
def transform(grid):
    H = len(grid)
    W = len(grid[0])
    out_H = H * 3
    out_W = W * 3
    output = [[0 for _ in range(out_W)] for _ in range(out_H)]
    for r in range(out_H):
        i = r % H
        block_r = r // H
        reverse = (block_r % 2 == 1)
        base_row = grid[i]
        if reverse:
            # reverse the row
            base_row = base_row[::-1]
        for c in range(out_W):
            j = c % W
            output[r][c] = base_row[j]
    return output
```

