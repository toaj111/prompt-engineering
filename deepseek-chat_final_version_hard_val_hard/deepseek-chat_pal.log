### Python Program

```python
def transform(grid):
    h = len(grid)
    w = len(grid[0])
    # Find stem column: column with a vertical run of 2's, possibly with a 4 at top.
    stem_col = None
    for c in range(w):
        found_2 = False
        for r in range(h):
            if grid[r][c] == 2:
                found_2 = True
                break
        if found_2:
            # verify it's a vertical run (at least two consecutive 2's)
            count = 0
            for r in range(h):
                if grid[r][c] == 2:
                    count += 1
                elif grid[r][c] == 4:
                    # allow 4 at top
                    pass
                else:
                    if count >= 1:
                        break
            if count >= 1:
                stem_col = c
                break
    if stem_col is None:
        stem_col = w // 2  # fallback

    # Initialize output with background 8
    out = [[8 for _ in range(w)] for __ in range(h)]

    # Draw vertical line at stem_col
    for r in range(h):
        out[r][stem_col] = 2

    # For each row, find leftmost and rightmost cells that are 1 or 3 in input.
    # If both exist and there is at least one gap (8) between them, fill between with 2.
    for r in range(h):
        left = None
        right = None
        for c in range(w):
            if grid[r][c] in (1, 3):
                if left is None:
                    left = c
                right = c
        if left is not None and right is not None:
            # Check for gaps
            has_gap = False
            in_blob = False
            for c in range(w):
                if grid[r][c] in (1, 3):
                    in_blob = True
                else:
                    if in_blob:
                        # check if there is another blob later
                        for cc in range(c+1, w):
                            if grid[r][cc] in (1, 3):
                                has_gap = True
                                break
                        if has_gap:
                            break
            if has_gap:
                for c in range(left, right+1):
                    out[r][c] = 2
            else:
                # Single contiguous blob: maybe fill only if blob contains both 1 and 3?
                has_1 = any(grid[r][c] == 1 for c in range(left, right+1))
                has_3 = any(grid[r][c] == 3 for c in range(left, right+1))
                if has_1 and has_3:
                    for c in range(left, right+1):
                        out[r][c] = 2
                # else no fill (example 1)
    return out
```

