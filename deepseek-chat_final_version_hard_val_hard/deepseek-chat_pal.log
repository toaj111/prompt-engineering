### Python Program

```python
def transform(grid):
    h = len(grid)
    w = len(grid[0])
    # create a copy
    new_grid = [row[:] for row in grid]
    
    # find background color: the most frequent color in the grid
    freq = {}
    for r in range(h):
        for c in range(w):
            color = grid[r][c]
            freq[color] = freq.get(color, 0) + 1
    background = max(freq.items(), key=lambda x: x[1])[0]
    
    # collect all non-background cells that are not on the border of the grid
    cells = []
    for r in range(h):
        for c in range(w):
            if grid[r][c] != background and 0 < r < h-1 and 0 < c < w-1:
                cells.append((r, c, grid[r][c]))
                new_grid[r][c] = background  # clear original
    
    # sort cells by color then row then column
    cells.sort(key=lambda x: (x[2], x[0], x[1]))
    
    # place them in top-left available positions (excluding border)
    idx = 0
    for r in range(1, h-1):
        for c in range(1, w-1):
            if idx >= len(cells):
                break
            new_grid[r][c] = cells[idx][2]
            idx += 1
        if idx >= len(cells):
            break
    
    return new_grid
```

