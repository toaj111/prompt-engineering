def transform(grid):
    h = len(grid)
    w = len(grid[0])
    bg = grid[0][0]  # background color
    # visited for holes (0 cells)
    visited = [[False]*w for _ in range(h)]
    # directions for 4‑connectivity
    dirs = [(1,0),(-1,0),(0,1),(0,-1)]
    
    # helper to get connected component of 0s starting at (r,c)
    def get_hole(r,c):
        stack = [(r,c)]
        comp = []
        while stack:
            rr,cc = stack.pop()
            if visited[rr][cc]:
                continue
            visited[rr][cc] = True
            comp.append((rr,cc))
            for dr,dc in dirs:
                nr,nc = rr+dr, cc+dc
                if 0<=nr<h and 0<=nc<w and grid[nr][nc]==0 and not visited[nr][nc]:
                    stack.append((nr,nc))
        return comp
    
    # find all holes
    holes = []
    for r in range(h):
        for c in range(w):
            if grid[r][c]==0 and not visited[r][c]:
                hole = get_hole(r,c)
                holes.append(hole)
    
    # create output grid as copy of input
    out = [row[:] for row in grid]
    
    # process each hole
    for hole in holes:
        if not hole:
            continue
        # bounding box
        minR = min(r for r,_ in hole)
        maxR = max(r for r,_ in hole)
        minC = min(c for _,c in hole)
        maxC = max(c for _,c in hole)
        # find colored cells inside hole (non‑zero, non‑bg)
        colored = []
        for r,c in hole:
            val = grid[r][c]
            if val != 0 and val != bg:
                colored.append((r,c,val))
        # for each colored cell
        for r,c,color in colored:
            # distances to sides
            dist_top = r - minR
            dist_bot = maxR - r
            dist_left = c - minC
            dist_right = maxC - c
            # find minimum distance
            min_dist = min(dist_top, dist_bot, dist_left, dist_right)
            # choose side (priority: top, left, bottom, right)
            if dist_top == min_dist:
                # place block above top side
                block_r = minR - 2
                block_c = c - 1
                # ensure block within grid and not overlapping hole
                if block_r >= 0 and block_r+1 < h and block_c >=0 and block_c+1 < w:
                    # check if the four cells are not part of any other hole (i.e., not 0)
                    # but we can overwrite anyway as per examples
                    out[block_r][block_c] = color
                    out[block_r][block_c+1] = color
                    out[block_r+1][block_c] = color
                    out[block_r+1][block_c+1] = color
            elif dist_left == min_dist:
                # place block left of left side
                block_r = r - 1
                block_c = minC - 2
                if block_r >=0 and block_r+1 < h and block_c >=0 and block_c+1 < w:
                    out[block_r][block_c] = color
                    out[block_r][block_c+1] = color
                    out[block_r+1][block_c] = color
                    out[block_r+1][block_c+1] = color
            elif dist_bot == min_dist:
                # place block below bottom side
                block_r = maxR + 1
                block_c = c - 1
                if block_r >=0 and block_r+1 < h and block_c >=0 and block_c+1 < w:
                    out[block_r][block_c] = color
                    out[block_r][block_c+1] = color
                    out[block_r+1][block_c] = color
                    out[block_r+1][block_c+1] = color
            else: # dist_right
                # place block right of right side
                block_r = r - 1
                block_c = maxC + 1
                if block_r >=0 and block_r+1 < h and block_c >=0 and block_c+1 < w:
                    out[block_r][block_c] = color
                    out[block_r][block_c+1] = color
                    out[block_r+1][block_c] = color
                    out[block_r+1][block_c+1] = color
    return out
```

