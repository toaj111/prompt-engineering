### Python Program

```python
def transform(grid):
    h = len(grid)
    w = len(grid[0])
    # Find candidate constant column
    col_candidate = -1
    const_color = -1
    for col in range(w):
        # Check if column has same non-zero color for at least 3 consecutive rows
        color = None
        count = 0
        for row in range(h):
            val = grid[row][col]
            if val != 0:
                if color is None:
                    color = val
                    count = 1
                elif val == color:
                    count += 1
                else:
                    # reset if different color
                    color = val
                    count = 1
            else:
                color = None
                count = 0
            if count >= 3:
                col_candidate = col
                const_color = color
                break
        if col_candidate != -1:
            break
    if col_candidate == -1:
        # fallback: return empty grid
        return [[]]
    
    # Find rows where this column has const_color
    rows = []
    for row in range(h):
        if grid[row][col_candidate] == const_color:
            rows.append(row)
    if not rows:
        return [[]]
    min_row = min(rows)
    max_row = max(rows)
    # Determine width: maximum contiguous non-zero to the right of col_candidate across these rows
    max_width = 0
    for r in rows:
        c = col_candidate + 1
        width = 0
        while c < w and grid[r][c] != 0:
            width += 1
            c += 1
        if width > max_width:
            max_width = width
    # Extract subgrid
    subgrid = []
    for r in range(min_row, max_row+1):
        row_vals = []
        for c in range(col_candidate+1, col_candidate+1+max_width):
            if c < w:
                row_vals.append(grid[r][c])
            else:
                row_vals.append(0)
        subgrid.append(row_vals)
    # Replace zeros with value from above
    for c in range(max_width):
        for r in range(1, len(subgrid)):
            if subgrid[r][c] == 0:
                subgrid[r][c] = subgrid[r-1][c]
    return subgrid
```

