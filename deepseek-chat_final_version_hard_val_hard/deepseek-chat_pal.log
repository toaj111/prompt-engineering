def transform(grid):
    if not grid:
        return grid
    h = len(grid)
    w = len(grid[0])
    # background color from corners
    bg = grid[0][0]
    # visited matrix
    visited = [[False for _ in range(w)] for _ in range(h)]
    # directions for 4‑connectivity
    dirs = [(1,0), (-1,0), (0,1), (0,-1)]
    components = []  # each component: list of (r,c)
    # find components
    for r in range(h):
        for c in range(w):
            if grid[r][c] != bg and not visited[r][c]:
                # BFS
                queue = [(r,c)]
                visited[r][c] = True
                cells = []
                min_r, max_r = r, r
                min_c, max_c = c, c
                while queue:
                    cr, cc = queue.pop(0)
                    cells.append((cr, cc))
                    if cr < min_r: min_r = cr
                    if cr > max_r: max_r = cr
                    if cc < min_c: min_c = cc
                    if cc > max_c: max_c = cc
                    for dr, dc in dirs:
                        nr, nc = cr + dr, cc + dc
                        if 0 <= nr < h and 0 <= nc < w and not visited[nr][nc] and grid[nr][nc] == grid[r][c]:
                            visited[nr][nc] = True
                            queue.append((nr, nc))
                components.append({
                    'cells': cells,
                    'color': grid[r][c],
                    'min_r': min_r,
                    'max_r': max_r,
                    'min_c': min_c,
                    'max_c': max_c
                })
    # build overlap graph
    n = len(components)
    overlap = [[False]*n for _ in range(n)]
    for i in range(n):
        for j in range(i+1, n):
            ci = components[i]
            cj = components[j]
            # check column overlap
            if not (ci['max_c'] < cj['min_c'] or cj['max_c'] < ci['min_c']):
                overlap[i][j] = overlap[j][i] = True
    # group components by connectedness in overlap graph
    comp_group = [-1]*n
    groups = []
    for i in range(n):
        if comp_group[i] == -1:
            # start new group
            gid = len(groups)
            stack = [i]
            comp_group[i] = gid
            group_indices = [i]
            while stack:
                cur = stack.pop()
                for nb in range(n):
                    if overlap[cur][nb] and comp_group[nb] == -1:
                        comp_group[nb] = gid
                        stack.append(nb)
                        group_indices.append(nb)
            groups.append(group_indices)
    # initialize output grid with background
    out = [[bg for _ in range(w)] for _ in range(h)]
    # process each group
    for g in groups:
        # sort by min row (topmost first)
        g_sorted = sorted(g, key=lambda idx: components[idx]['min_r'])
        for idx, comp_idx in enumerate(g_sorted):
            comp = components[comp_idx]
            shift = -1 if idx % 2 == 0 else 1  # left for even index (0‑based)
            for r, c in comp['cells']:
                nc = c + shift
                # ensure within bounds (should be)
                if 0 <= nc < w:
                    out[r][nc] = comp['color']
    return out
