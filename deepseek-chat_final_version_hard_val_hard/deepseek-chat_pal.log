I'll write code that checks the border color, extracts objects, and then arranges them as per the observed outputs.

### Python Program

```python
def transform(grid):
    h = len(grid)
    w = len(grid[0])
    # find border color (color of all four corners)
    border = grid[0][0]
    # collect all non-border, non-zero cells as objects via BFS
    visited = [[False]*w for _ in range(h)]
    objects = []  # each object: list of (r,c,color)
    for r in range(h):
        for c in range(w):
            if not visited[r][c] and grid[r][c] != border and grid[r][c] != 0:
                # bfs
                stack = [(r,c)]
                visited[r][c] = True
                obj = []
                while stack:
                    cr, cc = stack.pop()
                    obj.append((cr,cc,grid[cr][cc]))
                    for dr, dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                        nr, nc = cr+dr, cc+dc
                        if 0 <= nr < h and 0 <= nc < w and not visited[nr][nc] and grid[nr][nc] != border and grid[nr][nc] != 0:
                            visited[nr][nc] = True
                            stack.append((nr,nc))
                objects.append(obj)
    # compute bounding box for each object
    bboxes = []
    for obj in objects:
        rows = [p[0] for p in obj]
        cols = [p[1] for p in obj]
        top = min(rows)
        bottom = max(rows)
        left = min(cols)
        right = max(cols)
        bboxes.append((top, bottom, left, right, obj))
    # sort objects by bottom descending, then by right descending
    bboxes.sort(key=lambda x: (-x[1], -x[3]))
    # determine max width across all objects
    max_width = 0
    for top, bottom, left, right, obj in bboxes:
        max_width = max(max_width, right-left+1)
    # build rows
    out_rows = []
    for top, bottom, left, right, obj in bboxes:
        # create a shape matrix for this object
        height = bottom - top + 1
        shape = [[0]*max_width for _ in range(height)]
        for r,c,color in obj:
            shape[r-top][c-left] = color
        # append all rows of shape that contain non-zero
        for row in shape:
            if any(cell != 0 for cell in row):
                out_rows.append(row)
    return out_rows
```

