### Python Program

```python
def transform(grid):
    H = len(grid)
    W = len(grid[0])
    output = [[0]*W for _ in range(H)]
    
    # Step 1: copy color 5 cells
    for r in range(H):
        for c in range(W):
            if grid[r][c] == 5:
                output[r][c] = 5
    
    # Step 2: detect hollow squares
    hollow_squares = []  # each: (r, c, B, I, touches_boundary)
    for r in range(H-2):
        for c in range(W-2):
            # collect border cells
            border_cells = []
            for dr in range(3):
                for dc in range(3):
                    if dr == 1 and dc == 1:
                        continue
                    border_cells.append(grid[r+dr][c+dc])
            center = grid[r+1][c+1]
            # check all border cells same color B != 0
            B = border_cells[0]
            if B == 0:
                continue
            all_same = all(cell == B for cell in border_cells)
            if not all_same:
                continue
            # center I != B
            I = center
            if I == B:
                continue
            # ensure center is not 0? In examples interior is non-zero. We'll allow 0? but examples have non-zero.
            # Record
            touches = (r == 0 or r+2 == H-1 or c == 0 or c+2 == W-1)
            hollow_squares.append((r, c, B, I, touches))
    
    # Step 3: build mapping from border color to interior color
    mapping = {}
    for _, _, B, I, _ in hollow_squares:
        mapping[B] = I  # if duplicate border colors, last wins; but assume unique
    
    # Step 4: draw boundary-touching hollow squares with recolored interior
    for r, c, B, I, touches in hollow_squares:
        if not touches:
            continue
        new_I = mapping.get(I, I)  # if I not in mapping, keep I
        # draw border
        for dr in range(3):
            for dc in range(3):
                if dr == 1 and dc == 1:
                    output[r+dr][c+dc] = new_I
                else:
                    output[r+dr][c+dc] = B
    return output
```

