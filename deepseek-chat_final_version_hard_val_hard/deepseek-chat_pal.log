### Python Program

```python
def transform(grid):
    h = len(grid)
    w = len(grid[0])
    # create output copy
    out = [row[:] for row in grid]
    
    # find all 5 cells
    fives = []
    for r in range(h):
        for c in range(w):
            if grid[r][c] == 5:
                fives.append((r,c))
    
    if not fives:
        return out
    
    # determine which are isolated markers
    markers = []
    for r,c in fives:
        isolated = True
        for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr, nc = r+dr, c+dc
            if 0 <= nr < h and 0 <= nc < w and grid[nr][nc] != 0:
                isolated = False
                break
        if isolated:
            markers.append((r,c))
    
    if not markers:
        return out
    
    # find pattern component: the connected component containing a non-isolated 5
    # first, identify non-isolated 5 cells (those not in markers)
    non_isolated_fives = [p for p in fives if p not in markers]
    if not non_isolated_fives:
        return out
    # start BFS from first non-isolated five
    start = non_isolated_fives[0]
    visited = set()
    stack = [start]
    pattern_cells = []
    while stack:
        r,c = stack.pop()
        if (r,c) in visited:
            continue
        visited.add((r,c))
        pattern_cells.append((r,c))
        for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:
            nr, nc = r+dr, c+dc
            if 0 <= nr < h and 0 <= nc < w and grid[nr][nc] != 0 and (nr,nc) not in visited:
                stack.append((nr,nc))
    
    # compute bounding box
    min_r = min(r for r,c in pattern_cells)
    max_r = max(r for r,c in pattern_cells)
    min_c = min(c for r,c in pattern_cells)
    max_c = max(c for r,c in pattern_cells)
    
    # find internal 5 (first non-isolated five in pattern)
    internal_five = None
    for r,c in pattern_cells:
        if grid[r][c] == 5 and (r,c) not in markers:
            internal_five = (r,c)
            break
    if internal_five is None:
        return out
    p5r, p5c = internal_five
    dr = p5r - min_r
    dc = p5c - min_c
    
    # for each marker, duplicate pattern
    for mr, mc in markers:
        ntl_r = mr - dr
        ntl_c = mc - dc
        # copy each cell of pattern bounding box
        for r in range(min_r, max_r+1):
            for c in range(min_c, max_c+1):
                val = grid[r][c]
                if val != 0 and (r,c) in visited: # only cells in pattern component
                    nr = ntl_r + (r - min_r)
                    nc = ntl_c + (c - min_c)
                    if 0 <= nr < h and 0 <= nc < w:
                        if val == 5 and (r,c) == (p5r, p5c):
                            out[nr][nc] = 0
                        else:
                            out[nr][nc] = val
        # ensure marker cell becomes 0 (might have been overwritten by pattern copy)
        out[mr][mc] = 0
    
    return out
```

