def transform(grid):
    h = len(grid)
    w = len(grid[0])
    out = [row[:] for row in grid]
    
    # Find palette row: the last row that has at least two non‑8 numbers not in a solid block of 1's.
    palette_row = None
    for r in range(h-1, -1, -1):
        non8 = [c for c in grid[r] if c != 8]
        if len(non8) >= 2:
            palette_row = r
            break
    if palette_row is None:
        return out
    
    # Extract palette colors (skip 8's)
    palette = [c for c in grid[palette_row] if c != 8]
    
    # Build mapping: consecutive pairs in palette
    mapping = {}
    for i in range(0, len(palette)-1, 2):
        mapping[palette[i]] = palette[i+1]
    
    # Find all frames: rectangles of 1's surrounded by 8's.
