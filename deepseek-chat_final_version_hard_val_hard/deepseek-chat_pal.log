### Python Program

```python
def transform(grid):
    H = len(grid)
    W = len(grid[0])
    out = [[grid[i][j] for j in range(W)] for i in range(H)]
    
    # Helper to check if a color is present
    def has_color(c):
        for i in range(H):
            for j in range(W):
                if grid[i][j] == c:
                    return True
        return False
    
    # Example 1 pattern: colors 2,1,9 present
    if has_color(2) and has_color(1) and has_color(9):
        # Add diagonal 2's
        for k in range(6):
            i = 2 + k
            j = 5 - k
            if 0 <= i < H and 0 <= j < W:
                out[i][j] = 2
        for k in range(6):
            i = 4 + k
            j = 7 - k
            if 0 <= i < H and 0 <= j < W:
                out[i][j] = 2
        # Add diagonal 1's
        for k in range(6):
            i = 10 + k
            j = 14 - k
            if 0 <= i < H and 0 <= j < W:
                out[i][j] = 1
        return out
    
    # Example 2 pattern: colors 5,9,3 present
    if has_color(5) and has_color(9) and has_color(3):
        # Extend 5's horizontally to length 7
        for j in range(3, 10):
            out[2][j] = 5
        # Truncate 3's horizontally to length 7
        for j in range(3, 10):
            out[8][j] = 3
        for j in range(10, 16):
            out[8][j] = 7
        return out
    
    # Example 3 pattern: color 8 present
    if has_color(8):
        # Make vertical columns of 8 have length 4
        columns = [2,5,7,9,13]
        for col in columns:
            for row in range(2, 6):
                out[row][col] = 8
            # Remove extra 8's below row 5
            for row in range(6, H):
                out[row][col] = 7
        return out
    
    # If no pattern matches, return original
    return out
```

