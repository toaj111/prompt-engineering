### Python Program

```python
def transform(grid):
    h = len(grid)
    w = len(grid[0])
    # label components
    comp_id = [[-1]*w for _ in range(h)]
    comps = []  # each comp: list of (r,c,color)
    current_id = 0
    for r in range(h):
        for c in range(w):
            if grid[r][c] > 1 and comp_id[r][c] == -1:
                # bfs
                stack = [(r,c)]
                color = grid[r][c]
                cells = []
                while stack:
                    cr, cc = stack.pop()
                    if comp_id[cr][cc] != -1:
                        continue
                    comp_id[cr][cc] = current_id
                    cells.append((cr,cc,color))
                    for dr, dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                        nr, nc = cr+dr, cc+dc
                        if 0 <= nr < h and 0 <= nc < w and grid[nr][nc] == color and comp_id[nr][nc] == -1:
                            stack.append((nr,nc))
                comps.append(cells)
                current_id += 1
    # compute bounding boxes
    boxes = []
    for cells in comps:
        min_r = min(c[0] for c in cells)
        max_r = max(c[0] for c in cells)
        min_c = min(c[1] for c in cells)
        max_c = max(c[1] for c in cells)
        height = max_r - min_r + 1
        width = max_c - min_c + 1
        boxes.append((min_r, min_c, height, width, cells))
    # sort by top row then left col
    boxes.sort(key=lambda b: (b[0], b[1]))
    # create output grid filled with 1
    out = [[1]*w for _ in range(h)]
    # place each box
    for min_r, min_c, height, width, cells in boxes:
        # try to move left as far as possible
        target_r = min_r
        target_c = min_c
        # move left until collision or edge
        while target_c > 0:
            # check if area (target_r, target_c-1) to (target_r+height-1, target_c-1) is empty in out
            can_move = True
            for dr in range(height):
                r = target_r + dr
                c = target_c - 1
                if r < 0 or r >= h or c < 0 or c >= w:
                    can_move = False
                    break
                if out[r][c] != 1:
                    can_move = False
                    break
            if not can_move:
                break
            target_c -= 1
        # after moving left, if still overlapping with previous placements? Actually we check during left move.
        # Now try to move up as far as possible? But examples show objects move down, so we skip moving up.
        # Instead, if after moving left, the box overlaps with existing cells (should not because we checked), but maybe due to shape not rectangular.
        # We'll simply place the cells at the shifted position.
        dr = target_r - min_r
        dc = target_c - min_c
        for r,c,color in cells:
            nr = r + dr
            nc = c + dc
            if 0 <= nr < h and 0 <= nc < w:
                out[nr][nc] = color
    return out
```

