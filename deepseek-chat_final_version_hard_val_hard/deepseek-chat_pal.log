### Python Program

```python
def transform(grid):
    h = len(grid)
    w = len(grid[0])
    
    # Step 1: find dominant color (most frequent non-zero color)
    freq = {}
    for r in range(h):
        for c in range(w):
            col = grid[r][c]
            if col != 0:
                freq[col] = freq.get(col, 0) + 1
    if not freq:
        return [row[:] for row in grid]
    dominant = max(freq.items(), key=lambda x: x[1])[0]
    
    # Step 2: flood fill from all edge 0 cells to mark reachable
    reachable = [[False] * w for _ in range(h)]
    from collections import deque
    q = deque()
    for r in range(h):
        for c in range(w):
            if (r == 0 or r == h-1 or c == 0 or c == w-1) and grid[r][c] == 0:
                reachable[r][c] = True
                q.append((r, c))
    dirs = [(1,0), (-1,0), (0,1), (0,-1)]
    while q:
        r, c = q.popleft()
        for dr, dc in dirs:
            nr, nc = r + dr, c + dc
            if 0 <= nr < h and 0 <= nc < w and not reachable[nr][nc] and grid[nr][nc] == 0:
                reachable[nr][nc] = True
                q.append((nr, nc))
    
    # Step 3: create output and fill enclosed cells
    out = [row[:] for row in grid]
    for r in range(h):
        for c in range(w):
            if not reachable[r][c] and out[r][c] != dominant:
                out[r][c] = dominant
    return out
```

