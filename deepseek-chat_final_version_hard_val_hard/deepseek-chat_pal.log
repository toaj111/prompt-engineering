### Python Program

```python
def transform(grid):
    H = len(grid)
    W = len(grid[0])
    
    # Step 1: Rotate 90° clockwise if height > width
    if H > W:
        rotated = [[0 for _ in range(H)] for _ in range(W)]
        for r in range(H):
            for c in range(W):
                rotated[c][H-1-r] = grid[r][c]
        grid = rotated
        H, W = W, H
    
    # Step 2: Find connected components of non-zero colors (4-connectivity, same color)
    visited = [[False for _ in range(W)] for _ in range(H)]
    components = []
    
    for r in range(H):
        for c in range(W):
            if not visited[r][c] and grid[r][c] != 0:
                color = grid[r][c]
                stack = [(r, c)]
                cells = []
                while stack:
                    cr, cc = stack.pop()
                    if visited[cr][cc]:
                        continue
                    visited[cr][cc] = True
                    cells.append((cr, cc))
                    for dr, dc in [(1,0),(-1,0),(0,1),(0,-1)]:
                        nr, nc = cr + dr, cc + dc
                        if 0 <= nr < H and 0 <= nc < W and not visited[nr][nc] and grid[nr][nc] == color:
                            stack.append((nr, nc))
                components.append((color, cells))
    
    if not components:
        return grid
    
    # Step 3: Compute centroids and sort components by row-major order
    comp_info = []
    for color, cells in components:
        sr = sum(c[0] for c in cells)
        sc = sum(c[1] for c in cells)
        cent_r = sr / len(cells)
        cent_c = sc / len(cells)
        comp_info.append((cent_r, cent_c, color, cells))
    
    comp_info.sort(key=lambda x: (x[0], x[1]))
    
    # Step 4: Cyclic shift of colors among components
    num_comp = len(comp_info)
    color_map = {}
    for i in range(num_comp):
        old_color = comp_info[i][2]
        new_color = comp_info[(i + 1) % num_comp][2]
        color_map[old_color] = new_color
    
    # Step 5: Apply recoloring
    new_grid = [[0 for _ in range(W)] for _ in range(H)]
    for r in range(H):
        for c in range(W):
            new_grid[r][c] = grid[r][c]
    
    for _, _, old_color, cells in comp_info:
        new_color = color_map.get(old_color, old_color)
        for cr, cc in cells:
            new_grid[cr][cc] = new_color
    
    return new_grid
```

