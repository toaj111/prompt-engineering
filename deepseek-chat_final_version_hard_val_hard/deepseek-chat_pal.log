def transform(grid):
    # Determine background color: assume it's the color at top-left corner.
    bg = grid[0][0]
    # Find foreground color: the other color that appears in the shape.
    # We'll scan the grid for any non-bg color.
    fg = None
    for row in grid:
        for val in row:
            if val != bg:
                fg = val
                break
        if fg is not None:
            break
    if fg is None:
        # No foreground shape, return empty grid? Not expected.
        return [[bg]]
    
    # Find bounding box of foreground shape.
    rows = len(grid)
    cols = len(grid[0])
    min_r, max_r = rows, -1
    min_c, max_c = cols, -1
    for r in range(rows):
        for c in range(cols):
            if grid[r][c] != bg:
                if r < min_r: min_r = r
                if r > max_r: max_r = r
                if c < min_c: min_c = c
                if c > max_c: max_c = c
    # If no foreground found (should not happen), return empty.
    if min_r == rows:
        return [[bg]]
    
    # Extract subgrid within bounding box.
    subgrid = []
    for r in range(min_r, max_r + 1):
        row = []
        for c in range(min_c, max_c + 1):
            row.append(grid[r][c])
        subgrid.append(row)
    
    # Remove duplicate rows (keep first occurrence of each unique row).
    unique_rows = []
    seen_rows = []
    for row in subgrid:
        if row not in seen_rows:
            seen_rows.append(row)
            unique_rows.append(row)
    
    # Transpose to handle columns.
    # If unique_rows is empty, skip.
    if not unique_rows:
        return [[bg]]
    # Transpose: list of columns.
    cols_as_rows = list(zip(*unique_rows))
    # Remove duplicate columns.
    unique_cols = []
    seen_cols = []
    for col in cols_as_rows:
        if col not in seen_cols:
            seen_cols.append(col)
            unique_cols.append(col)
    # Transpose back to rows.
    reduced = list(zip(*unique_cols))
    # Convert to list of lists.
    reduced = [list(row) for row in reduced]
    
    # Add border of foreground color.
    h = len(reduced)
    w = len(reduced[0]) if h > 0 else 0
    new_h = h + 2
    new_w = w + 2
    new_grid = [[fg for _ in range(new_w)] for _ in range(new_h)]
