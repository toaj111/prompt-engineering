### Python Program

```python
def transform(grid):
    h = len(grid)
    w = len(grid[0])
    visited = [[False for _ in range(w)] for _ in range(h)]
    components = []  # list of lists of (r, c, color)
    # directions
    dirs = [(1,0), (-1,0), (0,1), (0,-1)]
    for r in range(h):
        for c in range(w):
            if grid[r][c] != 1 and not visited[r][c]:
                # start new component
                color = grid[r][c]
                stack = [(r, c)]
                comp = []
                visited[r][c] = True
                while stack:
                    cr, cc = stack.pop()
                    comp.append((cr, cc, color))
                    for dr, dc in dirs:
                        nr, nc = cr + dr, cc + dc
                        if 0 <= nr < h and 0 <= nc < w and not visited[nr][nc] and grid[nr][nc] == color:
                            visited[nr][nc] = True
                            stack.append((nr, nc))
                components.append(comp)
    # collect all cells
    all_cells = []
    for comp in components:
        all_cells.extend(comp)
    if not all_cells:
        return []
    # compute bounds
    min_r = min(c[0] for c in all_cells)
    max_r = max(c[0] for c in all_cells)
    min_c = min(c[1] for c in all_cells)
    max_c = max(c[1] for c in all_cells)
    out_h = max_r - min_r + 1
    out_w = max_c - min_c + 1
    output = [[0 for _ in range(out_w)] for _ in range(out_h)]
    for r, c, color in all_cells:
        output[r - min_r][c - min_c] = color
    return output
```

