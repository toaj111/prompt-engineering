```python
def transform(grid):
    N = len(grid)
    # Step 1: transform each row [a,b] -> [b,a,a,b]
    T = []
    for row in grid:
        a, b = row[0], row[1]
        T.append([b, a, a, b])
    
    # Step 2: build output rows
    out_rows = []
    for block in range(3):
        if block == 1:
            order = range(N)  # original order
        else:
            order = range(N-1, -1, -1)  # reverse order
        for idx in order:
            out_rows.append(T[idx])
    return out_rows
```

