### Python Program

```python
def transform(grid):
    rows = len(grid)
    cols = len(grid[0])
    # find the non-zero color
    fg_color = None
    for r in range(rows):
        for c in range(cols):
            if grid[r][c] != 0:
                fg_color = grid[r][c]
                break
        if fg_color is not None:
            break
    # mapping from input color to output color
    color_map = {5: 4, 8: 2, 3: 1}
    # if color not in map, maybe default to fg_color - 1, but not used in training
    out_color = color_map.get(fg_color, fg_color - 1 if fg_color is not None else 0)
    # create output grid
    new_grid = [[0 for _ in range(cols)] for _ in range(rows)]
    for r in range(rows):
