### Python Program

```python
def transform(grid):
    n = len(grid)
    output = [[0] * n for _ in range(n)]
    # copy diagonal
    for i in range(n):
        output[i][i] = grid[i][i]
    # transpose non-zero off-diagonal cells
    for r in range(n):
        for c in range(n):
            if r != c and grid[r][c] != 0:
                output[c][r] = grid[r][c]
    # remove duplicate symmetric values (keep above diagonal)
    for r in range(n):
        for c in range(r + 1, n):
            if output[r][c] == output[c][r] and output[r][c] != 0:
                output[c][r] = 0
    return output
```

