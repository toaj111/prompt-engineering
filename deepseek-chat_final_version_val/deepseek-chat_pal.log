### Python Program

```python
def transform(grid):
    h = len(grid)
    w = len(grid[0])
    out = [row[:] for row in grid]
    
    for i in range(h):
        for j in range(w):
            # Pattern: three consecutive 5's become 7's if middle has a 2 below
            if j+2 < w and grid[i][j] == 5 and grid[i][j+1] == 5 and grid[i][j+2] == 5:
                if i+1 < h and grid[i+1][j+1] == 2:
                    out[i][j] = 7
                    out[i][j+1] = 7
                    out[i][j+2] = 7
            # Pattern: 2 with 5 to right and 5 further right -> gradient 2,4,7
            if grid[i][j] == 2:
                # right
                if j+2 < w and grid[i][j+1] == 5 and grid[i][j+2] == 5:
                    out[i][j+1] = 4
                    out[i][j+2] = 7
                # left
                if j-2 >= 0 and grid[i][j-1] == 5 and grid[i][j-2] == 5:
                    out[i][j-1] = 4
                    out[i][j-2] = 7
                # down
                if i+2 < h and grid[i+1][j] == 5 and grid[i+2][j] == 5:
                    out[i+1][j] = 4
                    out[i+2][j] = 7
                # up
                if i-2 >= 0 and grid[i-1][j] == 5 and grid[i-2][j] == 5:
                    out[i-1][j] = 4
                    out[i-2][j] = 7
            # Pattern: 5 between two 2's becomes 4
            if j-1 >= 0 and j+1 < w and grid[i][j] == 5 and grid[i][j-1] == 2 and grid[i][j+1] == 2:
                out[i][j] = 4
            # Pattern: 5 after two 2's becomes 7
            if j-2 >= 0 and grid[i][j] == 5 and grid[i][j-1] == 2 and grid[i][j-2] == 2:
                out[i][j] = 7
    return out
```

