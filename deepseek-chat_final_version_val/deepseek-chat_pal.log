### Python Program

```python
def transform(grid):
    h = len(grid)
    w = len(grid[0])
    # create output grid, start with copy of input
    out = [row[:] for row in grid]
    # collect positions of 8 and 3
    eights = []
    threes = []
    for r in range(h):
        for c in range(w):
            if grid[r][c] == 8:
                eights.append((r,c))
            elif grid[r][c] == 3:
                threes.append((r,c))
    # draw lines from each 8 in direction down-right (1,1)
    for r,c in eights:
        dr, dc = 1, 1
        rr, cc = r+dr, c+dc
        while 0 <= rr < h and 0 <= cc < w:
            if out[rr][cc] == 0:
                out[rr][cc] = 8
            elif out[rr][cc] == 3:
                out[rr][cc] = 6
            # stop if hit any non-zero? maybe continue
            rr += dr
            cc += dc
    # draw lines from each 3 in direction down-left (1,-1)
    for r,c in threes:
        dr, dc = 1, -1
        rr, cc = r+dr, c+dc
        while 0 <= rr < h and 0 <= cc < w:
            if out[rr][cc] == 0:
                out[rr][cc] = 3
            elif out[rr][cc] == 8:
                out[rr][cc] = 6
            rr += dr
            cc += dc
    return out
```

