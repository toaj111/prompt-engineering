### Python Program

```python
def transform(grid):
    # First pass: replace all 1s with 2s in the original grid
    new_grid = []
    for row in grid:
        new_row = []
        for cell in row:
            if cell == 1:
                new_row.append(2)
            else:
                new_row.append(cell)
        new_grid.append(new_row)
    
    # Second pass: find rows that are not all zeros and append them again
    rows_to_duplicate = []
    for row in grid:
        has_non_zero = False
        for cell in row:
            if cell != 0:
                has_non_zero = True
                break
        if has_non_zero:
            rows_to_duplicate.append(row)
    
    # Append the duplicated rows (with 1s replaced by 2s)
    for row in rows_to_duplicate:
        new_row = []
        for cell in row:
            if cell == 1:
                new_row.append(2)
            else:
                new_row.append(cell)
        new_grid.append(new_row)
    
    return new_grid
```

