def transform(grid):
    rows = len(grid)
    cols = len(grid[0])
    
    # Create a copy of the grid to modify
    new_grid = [[grid[r][c] for c in range(cols)] for r in range(rows)]
    
    # Find vertical lines (consecutive same color in a column, length >= 2)
    vertical_lines = []  # (col, start_row, end_row, color)
    for c in range(cols):
        r = 0
        while r < rows:
            start = r
            color = grid[r][c]
            r += 1
            while r < rows and grid[r][c] == color:
                r += 1
            if r - start >= 2:  # found a vertical line
                vertical_lines.append((c, start, r-1, color))
    
    # Find horizontal lines (consecutive same color in a row, length >= 2)
    horizontal_lines = []  # (row, start_col, end_col, color)
    for r in range(rows):
        c = 0
        while c < cols:
            start = c
            color = grid[r][c]
            c += 1
            while c < cols and grid[r][c] == color:
                c += 1
            if c - start >= 2:  # found a horizontal line
                horizontal_lines.append((r, start, c-1, color))
    
    # For each intersection between vertical and horizontal lines
    for v_line in vertical_lines:
        v_col, v_start, v_end, v_color = v_line
        for h_line in horizontal_lines:
            h_row, h_start, h_end, h_color = h_line
            
            # Check if they intersect or would intersect if extended
            if v_start <= h_row <= v_end or h_start <= v_col <= h_end:
                # They intersect at (h_row, v_col)
                intersection_row = h_row
                intersection_col = v_col
                
                # Fill the entire column with vertical color (except intersection row)
                for r in range(rows):
                    if r != intersection_row:
                        new_grid[r][v_col] = v_color
                
                # Fill the entire row with horizontal color
                for c in range(cols):
                    new_grid[h_row][c] = h_color
                
                # Set intersection color
                new_grid[intersection_row][intersection_col] = (v_color + h_color) // 2 - 1
    
    return new_grid
```

